    create  table
      "warehouse"."main"."gold_customer_360__dbt_tmp"
  
    as (
      -- models/gold/gold_customer_360.sql
-- THE single customer view — joins all 4 sources



with txn as (
    select
        customer_id_hash,
        count(distinct order_id)                    as total_orders,
        round(sum(net_amount_inr), 2)               as total_spend_inr,
        round(avg(net_amount_inr), 2)               as avg_order_value,
        count(case when is_return then 1 end)       as total_returns,
        round(count(case when is_return then 1 end) * 1.0
              / nullif(count(distinct order_id), 0), 4) as return_rate,
        max(order_date)                             as last_order_date,
        case
            when sum(net_amount_inr) > 500000 then 'Platinum'
            when sum(net_amount_inr) > 100000 then 'Gold'
            when sum(net_amount_inr) > 25000  then 'Silver'
            else 'Bronze'
        end                                         as clv_tier
    from "warehouse"."main"."silver_transactions"
    group by customer_id_hash
),

web as (
    select
        customer_id_hash,
        count(*)                                    as total_web_events,
        count(case when event_type='add_to_cart' then 1 end) as cart_adds,
        mode() within group (order by device)       as preferred_device,
        mode() within group (order by category)     as favourite_category
    from "warehouse"."main"."silver_web_logs"
    group by customer_id_hash
),

rev as (
    select
        customer_id_hash,
        count(*)                                    as total_reviews,
        round(avg(rating), 2)                       as avg_rating,
        count(case when sentiment='positive' then 1 end) as positive_reviews,
        count(case when sentiment='negative' then 1 end) as negative_reviews
    from "warehouse"."main"."silver_reviews"
    group by customer_id_hash
)

select
    t.customer_id_hash,
    coalesce(t.total_orders,     0)                as total_orders,
    coalesce(t.total_spend_inr,  0)                as total_spend_inr,
    coalesce(t.avg_order_value,  0)                as avg_order_value,
    coalesce(t.total_returns,    0)                as total_returns,
    coalesce(t.return_rate,      0)                as return_rate,
    t.clv_tier,
    t.last_order_date,
    coalesce(w.total_web_events, 0)                as total_web_events,
    coalesce(w.cart_adds,        0)                as cart_adds,
    w.preferred_device,
    w.favourite_category,
    coalesce(r.total_reviews,    0)                as total_reviews,
    coalesce(r.avg_rating,       0)                as avg_rating,
    coalesce(r.positive_reviews, 0)                as positive_reviews,
    coalesce(r.negative_reviews, 0)                as negative_reviews,
    current_timestamp                              as refreshed_at
from txn t
left join web w using (customer_id_hash)
left join rev r using (customer_id_hash)
    );
  
  
